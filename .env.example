# Copy to .env and fill in. deploy.sh reads these.
# COUCHELEPHANT_HOST=          ssh host that runs Docker, e.g. plexbox
# COUCHELEPHANT_REMOTE_DIR=/opt/couchelephant
# COUCHELEPHANT_PORT=8710
# COUCHELEPHANT_TZ=UTC
# The own recorder, optional. See docs/INSTALL.md.
# COUCHELEPHANT_RECORDINGS_DIR=   a folder on the host for recordings; turns the recorder on
# COUCHELEPHANT_LIBRARY_DIR=      the folder your Plex library reads
# COUCHELEPHANT_DRI=1             pass /dev/dri in, for the graphics chip
