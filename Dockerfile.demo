# The public demo for the App Store reviewer (docs/demo.md).
#
# Not the shipping image: it carries the invented world the Apple tests use
# (the fake Plex, the fake tuner, the invented guide), and the viewing copies of
# the demo's recordings, made here once so a start is quick. Build from the
# repository root:
#
#   docker build -f Dockerfile.demo -t couchelephant-demo .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    DEMO_DATA=/data \
    DEMO_MEDIA=/opt/demo-media \
    PORT=8710

# ffmpeg draws the test pattern and makes the viewing copy of a live channel.
# No comskip, no GPU drivers: the ad breaks are seeded, the encoder is software.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin demo \
 && mkdir -p /data /opt/demo-media \
 && chown demo /data /opt/demo-media

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY tests/__init__.py tests/demo_guide.py tests/demo_world.py tests/fake_plex.py \
     tests/fake_tuner.py ./tests/
COPY scripts/demo_server.py ./scripts/

USER demo
# The recordings' viewing copies, made at build time (a few minutes of ffmpeg).
RUN python scripts/demo_server.py --media-only

VOLUME ["/data"]
EXPOSE 8710

HEALTHCHECK --interval=60s --timeout=5s --start-period=60s --retries=3 \
  CMD python3 -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('PORT', '8710'), timeout=4).status == 200 else 1)"

CMD ["python", "scripts/demo_server.py"]
