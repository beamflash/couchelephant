# Copy to .env and set DEMO_CODE. The code is the review code in the App Store
# notes and also the web password for the user "reviewer". At least 12 characters.
DEMO_CODE=
# The name Caddy gets a certificate for.
DEMO_HOST=demo.couchelephant.app
# The timezone the guide is shown in, and the clock the nightly reset (04:00) uses.
TZ=America/Los_Angeles
