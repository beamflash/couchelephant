# Copy to .env and set DEMO_CODE: the access code in the App Store notes, typed
# on a TV remote, and the web password for the user "reviewer". 12 to 16
# lowercase letters and digits, none of 0 o 1 l i. Make one with:
#   python3 -c "import secrets;print(''.join(secrets.choice('abcdefghjkmnpqrstuvwxyz23456789') for _ in range(14)))"
DEMO_CODE=
# The name Caddy gets a certificate for.
DEMO_HOST=demo.couchelephant.app
# The timezone the guide is shown in, and the clock the nightly reset (04:00) uses.
TZ=America/Los_Angeles
